# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./shopee_saas.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/shopee_saas
# For MySQL: DATABASE_URL=mysql://user:password@localhost:3306/shopee_saas

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bot Configuration
MAX_CONCURRENT_BOTS=10
BOT_TIMEOUT=300

# Redis (for task queue)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
